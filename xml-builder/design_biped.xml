<mujoco model="design_biped">
  <compiler angle="radian" autolimits="true"/>

  <option timestep="0.002" iterations="50" ls_iterations="50" integrator="implicitfast" cone="elliptic">
    <flag eulerdamp="disable"/>
  </option>

  <visual>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
    <global azimuth="120" elevation="-15"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
              rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <default>
    <geom contype="1" conaffinity="0" friction="0.9 0.02 0.001" solimp="0.9 0.95 0.001" solref="0.01 1"/>
    <default class="visual">
      <geom contype="0" conaffinity="0" group="2" rgba="0.7 0.7 0.75 1" density="0"/>
    </default>
    <default class="collision">
      <geom contype="1" conaffinity="1" group="3" rgba="0.7 0.5 0.3 0.4"/>
    </default>
    <default class="abad">
      <joint damping="1.0" armature="0.05" frictionloss="0.1"/>
      <motor ctrlrange="-79.82 79.82" forcerange="-79.82 79.82"/>
    </default>
    <default class="hip">
      <joint damping="1.0" armature="0.05" frictionloss="0.1"/>
      <motor ctrlrange="-79.82 79.82" forcerange="-79.82 79.82"/>
    </default>
    <default class="knee">
      <!-- same catalog motor as abad/hip (identical torque rating); this class is
           applied at the thigh->shank joint even though the physical knee motor
           sits up in knee_{side}_act — the belt only relocates where the torque
           is applied mechanically, not the limits themselves. -->
      <joint damping="1.0" armature="0.05" frictionloss="0.1"/>
      <motor ctrlrange="-79.82 79.82" forcerange="-79.82 79.82"/>
    </default>
    <default class="ankle">
      <!-- catalog entry 51 (MotorMN8014_framed+CPG:N=4.00): 19.97 Nm peak.
           joint dynamics (damping/armature/frictionloss) kept from biped.xml's
           original ankle_R_Joint/ankle_L_Joint, which used lighter values than
           abad/hip/knee. -->
      <joint damping="0.5" armature="0.02" frictionloss="0.01"/>
      <motor ctrlrange="-19.97 19.97" forcerange="-19.97 19.97"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 3" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="10 10 0.05" material="groundplane" friction="0.9 0.02 0.001"
          contype="1" conaffinity="1"/>

    <body name="base_Link" pos="0 0 0.767">
      <freejoint name="root"/>
      <inertial pos="0 0 0" mass="12" diaginertia="0.103699 0.109001 0.140501"/>
      <site name="imu" pos="0 0 0" size="0.01"/>
      <geom class="visual" type="box" size="0.135 0.13 0.095" rgba="0.79216 0.81961 0.93333 1"/>
      <geom class="collision" type="box" size="0.135 0.13 0.095"/>

      <!-- ==================== RIGHT LEG (actuator cluster + thigh) ==================== -->
      <body name="abad_R_act" pos="0.027250 -0.085028 -0.189972">
        <!-- welded to base: no <joint> element -->
        <inertial pos="0 0 0" quat="0.707107 0 0.707107 0" mass="2.247312" diaginertia="0.001693 0.001693 0.002273"/>
        <geom class="visual" type="cylinder" size="0.044972 0.02725" quat="0.707107 0 0.707107 0"/>
          <geom class="collision" type="cylinder" size="0.044972 0.02725" quat="0.707107 0 0.707107 0"/>

        <body name="hip_R_act" pos="-0.092222 0.029213 0.000000">
          <joint class="abad" name="abad_R_Joint" axis="-1 0 0" range="-0.38397 1.39626"/>
          <inertial pos="0 0 0" quat="0.707107 0.707107 0 0" mass="2.247312" diaginertia="0.001693 0.001693 0.002273"/>
          <geom class="visual" type="cylinder" size="0.044972 0.02725" quat="0.707107 0.707107 0 0"/>
          <geom class="collision" type="cylinder" size="0.044972 0.02725" quat="0.707107 0.707107 0 0"/>

          <body name="knee_R_act" pos="0.000000 -0.086500 0.000000">
            <joint class="hip" name="hip_R_Joint" axis="0 -1 0" range="-1.39626 1.01229"/>
            <inertial pos="0 0 0" quat="0.707107 0.707107 0 0" mass="2.247312" diaginertia="0.001693 0.001693 0.002273"/>
            <geom class="visual" type="cylinder" size="0.044972 0.02725" quat="0.707107 0.707107 0 0"/>
          <geom class="collision" type="cylinder" size="0.044972 0.02725" quat="0.707107 0.707107 0 0"/>

            <!-- thigh_link: welded to knee_R_act (fixed joint = no <joint> element).
                 A single cylinder (radius = knee-actuator radius, length = the full
                 hip/knee-actuator gap) + a cuboid (dimensions from the original
                 SF_TRON1.xml thigh box) whose small end face sits tangent to the
                 cylinder's side, extending along the original file's hip->knee
                 direction. No explicit <inertial>: mass/COM/inertia auto-derived
                 by MuJoCo from geom density x volume (density set only on the
                 collision geoms; visual class has density=0 so the duplicate
                 visual geoms don't double the mass). -->
            <body name="thigh_R_Link" pos="0.000000 0.043250 0.000000">
              <geom class="visual" type="cylinder" size="0.044972 0.016000"
                    pos="0.000000 0.000000 0.000000" quat="0.707107 0.707107 0 0"/>
              <geom class="collision" type="cylinder" size="0.044972 0.016000"
                    pos="0.000000 0.000000 0.000000" quat="0.707107 0.707107 0 0" density="2700.0"/>
              <geom class="visual" type="box" size="0.025 0.016 0.125" pos="-0.097492 0.000000 -0.139233" quat="0.300706 0.000000 -0.953717 0.000000"/>
              <geom class="collision" type="box" size="0.025 0.016 0.125" pos="-0.097492 0.000000 -0.139233" quat="0.300706 0.000000 -0.953717 0.000000"
                    density="2700.0"/>

              <!-- shank_R_Link: PER YOUR UPLOADED EDIT — biped.xml's original
                   hip_R_Link->knee_R_Link pos/quat, with the y-component zeroed
                   for both legs (no more side-dependent ±0.0395 jog).
                   The belt-driven knee DOF lives HERE, at the thigh->shank joint —
                   not at knee_R_act, which upstream only carries the actuator's
                   own mass/geometry (no joint of its own). Torque/limit numbers for
                   the knee motor are still applied to THIS joint, since that's where
                   MuJoCo needs them regardless of the belt's physical routing.
                   Shank geometry/inertial: PLACEHOLDER, reused verbatim from the
                   original SF_TRON1.xml's knee_R_Link/knee_L_Link (no new shank
                   dimensions given) — replace when you have them. -->
              <body name="shank_R_Link" pos="-0.200752 0.0 -0.286703"
                    quat="0.939692 0 -0.342022 0">
                <joint class="knee" name="knee_R_Joint" axis="0 -1 0" range="-1.21357 1.17267"/>
                <inertial pos="-0.160778 0.00788018 -0.0843318" quat="0.391642 0.609187 0.580027 0.37293"
                          mass="1.0" diaginertia="0.04326 0.039749 0.003806"/>
                <geom class="visual" type="box" size="0.0125 0.016 0.15"
                      pos="0.0 0.0 -0.15"/>
                <geom class="collision" type="box" size="0.0125 0.016 0.15"
                      pos="0.0 0.0 -0.15"/>

                <!-- ankle_R_act: ankle actuator (catalog radius/halflen) + foot,
                     at the end of the shank — exact biped.xml shank->ankle transform.
                     Foot cuboid dims copied verbatim from biped.xml's foot box.
                     Inertial: catalog said ankle mass "not queried, used biped.xml's
                     fixed reference cylinder" -> reused biped.xml's original
                     ankle_R_Link/ankle_L_Link inertial (mass 0.7 kg), which already
                     combined the ankle mechanism + foot the same way this body does. -->
                <body name="ankle_R_act" pos="-0.017221 0.0 -0.343079"
                      quat="0.939681 0 0.342052 0">
                  <joint class="ankle" name="ankle_R_Joint" axis="0 -1 0" range="-0.791917 1.30899"/>
                  <inertial pos="0.01 0.0 -0.035"
                            quat="0 0.707107 0 0.707107" mass="0.7"
                            diaginertia="0.002619 0.002386 0.0003387"/>
                  <geom class="visual" type="cylinder" size="0.03 0.02725" quat="0.707107 0.707107 0 0"/>
                  <geom class="collision" type="cylinder" size="0.03 0.02725" quat="0.707107 0.707107 0 0"/>
                  <geom class="visual" type="box" size="0.1 0.035 0.015"
                        pos="0.01 0.0 -0.035"/>
                  <geom class="collision" name="foot_R_collision" type="box"
                        size="0.1 0.035 0.015"
                        pos="0.01 0.0 -0.035"/>
                  <site name="foot_R" pos="0.01 0.0 -0.05" size="0.01"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

      <!-- ==================== LEFT LEG (actuator cluster + thigh) ==================== -->
      <body name="abad_L_act" pos="0.027250 0.085028 -0.189972">
        <!-- welded to base: no <joint> element -->
        <inertial pos="0 0 0" quat="0.707107 0 0.707107 0" mass="2.247312" diaginertia="0.001693 0.001693 0.002273"/>
        <geom class="visual" type="cylinder" size="0.044972 0.02725" quat="0.707107 0 0.707107 0"/>
          <geom class="collision" type="cylinder" size="0.044972 0.02725" quat="0.707107 0 0.707107 0"/>

        <body name="hip_L_act" pos="-0.092222 -0.029213 0.000000">
          <joint class="abad" name="abad_L_Joint" axis="1 0 0" range="-0.38397 1.39626"/>
          <inertial pos="0 0 0" quat="0.707107 0.707107 0 0" mass="2.247312" diaginertia="0.001693 0.001693 0.002273"/>
          <geom class="visual" type="cylinder" size="0.044972 0.02725" quat="0.707107 0.707107 0 0"/>
          <geom class="collision" type="cylinder" size="0.044972 0.02725" quat="0.707107 0.707107 0 0"/>

          <body name="knee_L_act" pos="0.000000 0.086500 0.000000">
            <joint class="hip" name="hip_L_Joint" axis="0 -1 0" range="-1.39626 1.01229"/>
            <inertial pos="0 0 0" quat="0.707107 0.707107 0 0" mass="2.247312" diaginertia="0.001693 0.001693 0.002273"/>
            <geom class="visual" type="cylinder" size="0.044972 0.02725" quat="0.707107 0.707107 0 0"/>
          <geom class="collision" type="cylinder" size="0.044972 0.02725" quat="0.707107 0.707107 0 0"/>

            <!-- thigh_link: welded to knee_L_act (fixed joint = no <joint> element).
                 A single cylinder (radius = knee-actuator radius, length = the full
                 hip/knee-actuator gap) + a cuboid (dimensions from the original
                 SF_TRON1.xml thigh box) whose small end face sits tangent to the
                 cylinder's side, extending along the original file's hip->knee
                 direction. No explicit <inertial>: mass/COM/inertia auto-derived
                 by MuJoCo from geom density x volume (density set only on the
                 collision geoms; visual class has density=0 so the duplicate
                 visual geoms don't double the mass). -->
            <body name="thigh_L_Link" pos="0.000000 -0.043250 0.000000">
              <geom class="visual" type="cylinder" size="0.044972 0.016000"
                    pos="0.000000 0.000000 0.000000" quat="0.707107 0.707107 0 0"/>
              <geom class="collision" type="cylinder" size="0.044972 0.016000"
                    pos="0.000000 0.000000 0.000000" quat="0.707107 0.707107 0 0" density="2700.0"/>
              <geom class="visual" type="box" size="0.025 0.016 0.125" pos="-0.097492 0.000000 -0.139233" quat="0.300706 0.000000 -0.953717 0.000000"/>
              <geom class="collision" type="box" size="0.025 0.016 0.125" pos="-0.097492 0.000000 -0.139233" quat="0.300706 0.000000 -0.953717 0.000000"
                    density="2700.0"/>

              <!-- shank_L_Link: PER YOUR UPLOADED EDIT — biped.xml's original
                   hip_R_Link->knee_R_Link pos/quat, with the y-component zeroed
                   for both legs (no more side-dependent ±0.0395 jog).
                   The belt-driven knee DOF lives HERE, at the thigh->shank joint —
                   not at knee_L_act, which upstream only carries the actuator's
                   own mass/geometry (no joint of its own). Torque/limit numbers for
                   the knee motor are still applied to THIS joint, since that's where
                   MuJoCo needs them regardless of the belt's physical routing.
                   Shank geometry/inertial: PLACEHOLDER, reused verbatim from the
                   original SF_TRON1.xml's knee_R_Link/knee_L_Link (no new shank
                   dimensions given) — replace when you have them. -->
              <body name="shank_L_Link" pos="-0.200752 0.0 -0.286703"
                    quat="0.939692 0 -0.342022 0">
                <joint class="knee" name="knee_L_Joint" axis="0 -1 0" range="-0.872665 1.36136"/>
                <inertial pos="-0.160778 0.00788018 -0.0843318" quat="0.391642 0.609187 0.580027 0.37293"
                          mass="1.0" diaginertia="0.04326 0.039749 0.003806"/>
                <geom class="visual" type="box" size="0.0125 0.016 0.15"
                      pos="0.0 0.0 -0.15"/>
                <geom class="collision" type="box" size="0.0125 0.016 0.15"
                      pos="0.0 0.0 -0.15"/>

                <!-- ankle_L_act: ankle actuator (catalog radius/halflen) + foot,
                     at the end of the shank — exact biped.xml shank->ankle transform.
                     Foot cuboid dims copied verbatim from biped.xml's foot box.
                     Inertial: catalog said ankle mass "not queried, used biped.xml's
                     fixed reference cylinder" -> reused biped.xml's original
                     ankle_R_Link/ankle_L_Link inertial (mass 0.7 kg), which already
                     combined the ankle mechanism + foot the same way this body does. -->
                <body name="ankle_L_act" pos="-0.017221 0.0 -0.343079"
                      quat="0.939681 0 0.342052 0">
                  <joint class="ankle" name="ankle_L_Joint" axis="0 -1 0" range="-0.791917 1.30899"/>
                  <inertial pos="0.01 0.0 -0.035"
                            quat="0 0.707107 0 0.707107" mass="0.7"
                            diaginertia="0.002619 0.002386 0.0003387"/>
                  <geom class="visual" type="cylinder" size="0.03 0.02725" quat="0.707107 0.707107 0 0"/>
                  <geom class="collision" type="cylinder" size="0.03 0.02725" quat="0.707107 0.707107 0 0"/>
                  <geom class="visual" type="box" size="0.1 0.035 0.015"
                        pos="0.01 0.0 -0.035"/>
                  <geom class="collision" name="foot_L_collision" type="box"
                        size="0.1 0.035 0.015"
                        pos="0.01 0.0 -0.035"/>
                  <site name="foot_L" pos="0.01 0.0 -0.05" size="0.01"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor class="abad" name="abad_R_motor" joint="abad_R_Joint"/>
    <motor class="hip" name="hip_R_motor" joint="hip_R_Joint"/>
    <motor class="knee" name="knee_R_motor" joint="knee_R_Joint"/>
    <motor class="ankle" name="ankle_R_motor" joint="ankle_R_Joint"/>
    <motor class="abad" name="abad_L_motor" joint="abad_L_Joint"/>
    <motor class="hip" name="hip_L_motor" joint="hip_L_Joint"/>
    <motor class="knee" name="knee_L_motor" joint="knee_L_Joint"/>
    <motor class="ankle" name="ankle_L_motor" joint="ankle_L_Joint"/>
  </actuator>

  <sensor>
    <framequat name="base_quat" objtype="site" objname="imu"/>
    <framepos name="base_pos" objtype="site" objname="imu"/>
    <gyro name="base_gyro" site="imu"/>
    <accelerometer name="base_accel" site="imu"/>
    <framepos name="foot_R_pos" objtype="site" objname="foot_R"/>
    <framepos name="foot_L_pos" objtype="site" objname="foot_L"/>
    <touch name="foot_R_touch" site="foot_R"/>
    <touch name="foot_L_touch" site="foot_L"/>
    <subtreecom name="base_subtreecom" body="base_Link"/>
    <subtreelinvel name="base_subtreelinvel" body="base_Link"/>
  </sensor>

  <keyframe>
    <!-- order: base(7) + [abad_R, hip_R, knee_R, ankle_R, abad_L, hip_L, knee_L, ankle_L] -->
    <key name="home" qpos="0 0 0.767 1 0 0 0 0 0.1 0.15 -0.1 0 0.1 0.15 -0.1"/>
  </keyframe>
</mujoco>