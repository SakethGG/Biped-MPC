              <body name="FR_calf" pos="0 0 -0.2130">
                <inertial pos="0 0 -0.1115" mass="0.195862"
                          diaginertia="0.000771 0.000771 0.00000967"/>
                <joint name="FR_calf_joint" axis="0 1 0"
