        <geom type="cylinder" size="0.0460 0.0200"
              quat="1 0 1 0" rgba="0.85 0.35 0.10 1"/>

        <!-- FR hip-flex actuator housing (abduction joint, axis x) -->
        <!-- offset = ABD_HALFLEN(0.02) + HIP_RADIUS(0.04) + gap(0.005) = 0.065 -->
        <!-- <body name="FR_hip_act" pos="0.0650 0 0"> -->
        <body name="FR_hip_act" pos="0.0831 0 0">
          <inertial pos="0 0 0" mass="0.520"
                    diaginertia="0.000344 0.000550 0.000344"/>
          <joint name="FR_hip_joint" axis="1 0 0"
                 range="-0.863 0.863" damping="1.0"
                 armature="0.01" frictionloss="0.2"/>
          <geom type="cylinder" size="0.0460 0.0200"
                quat="1 1 0 0" rgba="0.15 0.45 0.85 1"/>

          <!-- FR knee actuator housing (hip-flex joint, axis y) -->
          <!-- offset = HIP_HALFLEN(0.02) + KNEE_HALFLEN(0.02) + gap(0.01) = 0.05 -->
