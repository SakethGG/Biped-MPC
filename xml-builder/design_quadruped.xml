            <inertial pos="0 0 0" mass="0.520"
                      diaginertia="0.000344 0.000550 0.000344"/>
            <joint name="FR_thigh_joint" axis="0 1 0"
                   range="-0.686 4.501" damping="2.0"
                   armature="0.01" frictionloss="0.2"/>
            <geom type="cylinder" size="0.0460 0.0200"
                  quat="1 1 0 0" rgba="0.15 0.75 0.30 1"/>

            <!-- FR thigh link (fixed to knee actuator) -->
            <!-- y-offset = 0.03 so total lateral = 0.04675+0.05+0.03 = 0.12675 (= Go1) -->
            <body name="FR_thigh" pos="0 -0.03 0">
              <inertial pos="0 0 -0.099" mass="0.500"
                        diaginertia="0.002014 0.002014 0.0000552"/>
              <geom type="capsule"
                    fromto="0 0 0  0 0 -0.1980"
                    size="0.0150" rgba="0.6 0.6 0.6 1"/>

