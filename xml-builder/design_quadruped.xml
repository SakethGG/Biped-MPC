                  <inertial pos="0 0 0" mass="0.02"
                            diaginertia="0.00000423 0.00000423 0.00000423"/>
                  <geom name="FR" type="sphere" size="0.0230"
                        rgba="0.05 0.05 0.05 1"
                        friction="0.8 0.02 0.01"
                        solimp="0.015 1 0.023" condim="6" priority="1"/>
                  <site name="FR" pos="0 0 0" type="sphere" size="0.023" group="5"/>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>

