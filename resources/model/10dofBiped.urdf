    <parent link="knee_R_Link" />
    <child link="ankle_R_actuator_Link" />
  </joint>

  <link name="ankle_R_actuator_Link">
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="-0.02725 0 0" />
      <geometry>
        <cylinder length="0.0545" radius="0.03" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="-0.02725 0 0" />
      <geometry>
        <cylinder length="0.0545" radius="0.03" />
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.02725 0 0" />
      <mass value="0.95" />
      <inertia ixx="0.000428" ixy="0" ixz="0" iyy="0.000449" iyz="0" izz="0.000449" />
    </inertial>
  </link>

  <joint name="ankle_R_Joint" type="revolute">
    <origin rpy="0 0 0" xyz="-0.025 0 -0.025" />
    <parent link="ankle_R_actuator_Link" />
    <child link="ankle_R_Link" />
    <axis xyz="0 -1 0" />
    <dynamics damping="0" friction="0.01" />
    <limit effort="20" lower="-0.79191730631626" upper="1.30899" velocity="15" />
  </joint>

  <link name="ankle_R_Link">
    <visual>
      <origin xyz="0.01 0 -0.035" rpy="0 0 0" />
      <geometry>
        <box size="0.2 0.07 0.03" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.01 0 -0.035" rpy="0 0 0" />
      <geometry>
        <box size="0.2 0.07 0.03" />
