<?xml version="1.0" encoding="utf-8"?>
<!--
  SF_TRON1_10DOF
  Derived from the reference SF_TRON1 8-DOF biped URDF.
  Change: added a hip-YAW revolute joint at the top of each leg
  (between base_Link and the existing abad/roll actuator), turning
  each leg from 4-DOF (abad/roll, hip/pitch, knee/pitch, ankle/pitch)
  into 5-DOF (yaw, roll, pitch, pitch, pitch) -> 10-DOF total.

  All thigh/shank/ankle geometry, masses and inertias are unchanged
  from the reference. The new yaw stage reuses the same actuator
  form-factor (cylinder r=0.0483, L=0.0545, m=0.95) as the abad/ankle
  actuators, just re-oriented so its axis is Z instead of X, and adds
  a small bracket link to carry the yaw output into the original
  abad mounting point.
-->
<robot name="SF_TRON1_10DOF">

  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0" />
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0" />
  </material>
  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0" />
  </material>
  <material name="grey">
    <color rgba="0.2 0.2 0.2 1.0" />
  </material>
  <material name="silver">
    <color rgba="0.913725490196 0.913725490196 0.847058823529 1.0" />
  </material>
  <material name="orange">
    <color rgba="1.0 0.423529411765 0.0392156862745 1.0" />
  </material>
  <material name="brown">
    <color rgba="0.870588235294 0.811764705882 0.764705882353 1.0" />
  </material>
  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0" />
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0" />
  </material>
  <material name="yaw_bracket">
    <color rgba="0.35 0.35 0.35 1.0" />
  </material>

  <!-- ==================== BASE ==================== -->

  <link name="base_Link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.27 0.26 0.19" />
      </geometry>
      <material name="">
        <color rgba="0.79216 0.81961 0.93333 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.27 0.26 0.19" />
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <mass value="5" />
      <inertia ixx="0.043208" ixy="0" ixz="0" iyy="0.045417" iyz="0" izz="0.058542" />
    </inertial>
  </link>

  <!-- ==================== IMU ==================== -->

  <joint name="limx_imu_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0" />
    <parent link="base_Link" />
    <child link="limx_imu" />
  </joint>

  <link name="limx_imu">
    <inertial>
      <mass value="0.01" />
      <origin rpy="0 0 0" xyz="0 0 0" />
      <inertia ixx="0.000001" ixy="0" ixz="0" iyy="0.000001" iyz="0" izz="0.000001" />
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <geometry>
        <box size="0.015 0.015 0.004" />
      </geometry>
      <material name="orange" />
    </visual>
  </link>

  <!-- ==================== RIGHT LEG ==================== -->

  <!-- == NEW: Hip Yaw stage == -->

  <joint name="hip_yaw_R_fixed_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0.08865 -0.0817 -0.15" />
    <parent link="base_Link" />
    <child link="hip_yaw_R_actuator_Link" />
  </joint>

  <link name="hip_yaw_R_actuator_Link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.02725" />
      <geometry>
        <cylinder length="0.0545" radius="0.0483" />
      </geometry>
      <material name="yaw_bracket" />
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.02725" />
      <geometry>
        <cylinder length="0.0545" radius="0.0483" />
      </geometry>
    </collision>
    <inertial>
      <!-- Same cylinder as abad/ankle actuators, axis now Z -->
      <origin rpy="0 0 0" xyz="0 0 -0.02725" />
      <mass value="0.95" />
      <inertia ixx="0.000789" ixy="0" ixz="0" iyy="0.000789" iyz="0" izz="0.001108" />
    </inertial>
  </link>

  <joint name="hip_yaw_R_Joint" type="revolute">
    <origin rpy="0 0 0" xyz="0 0 -0.0545" />
    <parent link="hip_yaw_R_actuator_Link" />
    <child link="hip_yaw_R_Link" />
    <axis xyz="0 0 1" />
    <dynamics damping="0" friction="0" />
    <limit effort="40.0" lower="-0.3491" upper="0.3491" velocity="10.0" />
  </joint>

  <link name="hip_yaw_R_Link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.015" />
      <geometry>
        <box size="0.03 0.03 0.03" />
      </geometry>
      <material name="yaw_bracket" />
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.015" />
      <geometry>
        <box size="0.03 0.03 0.03" />
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 -0.015" />
      <mass value="0.3" />
      <inertia ixx="0.000045" ixy="0" ixz="0" iyy="0.000045" iyz="0" izz="0.000045" />
    </inertial>
  </link>

  <!-- == Everything below is unchanged from the reference, just reparented onto hip_yaw_R_Link == -->

  <joint name="abad_R_fixed_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 -0.0375" />
    <parent link="hip_yaw_R_Link" />
    <child link="abad_R_actuator_Link" />
  </joint>

  <link name="abad_R_actuator_Link">
    <visual>
      <origin rpy="0 1.57079632679 0" xyz="-0.02725 0 0" />
      <geometry>
        <cylinder length="0.0545" radius="0.0483" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 1.57079632679 0" xyz="-0.02725 0 0" />
      <geometry>
        <cylinder length="0.0545" radius="0.0483" />
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.02725 0 0" />
      <mass value="0.95" />
      <inertia ixx="0.001108" ixy="0" ixz="0" iyy="0.000789" iyz="0" izz="0.000789" />
    </inertial>
  </link>

  <joint name="abad_R_Joint" type="revolute">
    <origin rpy="0 0 0" xyz="-0.0545 0 0" />
    <parent link="abad_R_actuator_Link" />
    <child link="abad_R_Link" />
    <axis xyz="-1 0 0" />
    <dynamics damping="0" friction="0" />
    <limit effort="80.0" lower="-0.38397" upper="1.39626" velocity="15.0" />
  </joint>

  <link name="abad_R_Link">
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="-0.0683 0.035 0" />
      <geometry>
        <cylinder length="0.0545" radius="0.0483" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="-0.0683 0.035 0" />
      <geometry>
        <cylinder length="0.0545" radius="0.0483" />
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0683 0.035 0" />
      <mass value="1.469" />
      <inertia ixx="0.001220" ixy="0" ixz="0"
               iyy="0.001713" iyz="0" izz="0.001220" />
    </inertial>
  </link>

  <joint name="hip_R_Joint" type="revolute">
    <origin rpy="0 0 0" xyz="-0.0683 0.03050 0" />
    <parent link="abad_R_Link" />
    <child link="hip_R_Link" />
    <axis xyz="0 -1 0" />
    <dynamics damping="0" friction="0" />
    <limit effort="80.0" lower="-1.396263" upper="1.012291" velocity="15.0" />
  </joint>

  <link name="hip_R_Link">
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="0 -0.08275 0" />
      <geometry>
        <cylinder length="0.0545" radius="0.0483" />
      </geometry>
    </visual>
    <collision>
      <origin rpy="1.57079632679 0 0" xyz="0 -0.08275 0" />
      <geometry>
        <cylinder length="0.0545" radius="0.0483" />
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 -0.08275 0" />
      <mass value="0.95" />
      <inertia ixx="0.000789" ixy="0" ixz="0" iyy="0.001108" iyz="0" izz="0.000789" />
    </inertial>
  </link>

  <joint name="hip_R_fixed_joint" type="fixed">
    <origin rpy="0 0.610865 0" xyz="0 -0.08275 0" />
    <parent link="hip_R_Link" />
    <child link="hip_R_thigh_Link" />
  </joint>

  <link name="hip_R_thigh_Link">
    <visual>
      <origin rpy="1.57079632679 0 0" xyz="0 0.04325 0" />
      <geometry>
        <cylinder length="0.032" radius="0.0483" />
      </geometry>
    </visual>
    <visual>
      <origin rpy="0 0 0" xyz="0 0.04325 -0.175" />
      <geometry>
        <box size="0.05 0.032 0.25" />
